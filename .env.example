# Copie para `.env` (que é ignorado pelo Git) e preencha localmente.
# NUNCA coloque credenciais reais neste arquivo de exemplo.

# --- Diagnóstico da câmera real (Fase 0, scripts/diag) ---
# Host/IP da câmera na LAN. Pode mudar por DHCP.
NVR_CAM_HOST=192.0.2.10
NVR_CAM_RTSP_PORT=554
# Caminho RTSP sem credenciais (ex.: o que funcionou no VLC, sem usuário/senha).
NVR_CAM_RTSP_PATH=/CHANGE_ME
NVR_CAM_USER=CHANGE_ME
NVR_CAM_PASSWORD=CHANGE_ME

# --- Aplicação (Fase 1) ---
# Diretório de dados (banco, índice, snapshots). Gravações ficam no local escolhido pela UI.
NVR_DATA_DIR=./data
# Raízes nas quais a UI pode escolher o local de gravação (separadas por ';' no Windows, ':' no Linux).
NVR_STORAGE_ROOTS=./data/recordings
